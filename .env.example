# Copy to .env and fill in. Never commit .env.

# LLM (CrewAI agents). Without it the flows run in deterministic offline mode.
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (separate number from nadlan-pro's worker)
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=choose-any-string
WA_APP_SECRET=

# Optional: write meetings to nadlan-pro (calendar.backend: nadlan_pro)
GOOGLE_APPLICATION_CREDENTIALS=secrets/nadlan-pro.service-account.json
